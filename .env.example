# ==============================================================================
# MongoDB Ultra-Lightweight Document Q&A RAG Backend - Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Atlas Connection
# ------------------------------------------------------------------------------
# Example Atlas connection string:
# mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=mini_rag

# Optional: Set to your Atlas Vector Search index name if created on 'document_chunks' collection.
# If omitted or unavailable, the backend automatically uses Python cosine-similarity fallback.
ATLAS_VECTOR_INDEX_NAME=vector_index

# ------------------------------------------------------------------------------
# External AI Providers (Google Gemini via HTTPX)
# ------------------------------------------------------------------------------
# Set your Gemini API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Embedding API: Using Google's Gemini text-embedding-004 model (768 dimensions)
EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_SECONDS=30.0

# LLM Chat Completion API: Using Gemini 1.5 Flash (or gemini-2.0-flash / gemini-1.5-pro)
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=45.0

# ------------------------------------------------------------------------------
# RAG Chunking & Retrieval Parameters
# ------------------------------------------------------------------------------
MAX_UPLOAD_MB=10
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_CHUNKS=500
TOP_K=5

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# In production, set AUTH_API_KEY and set ALLOW_DEV_AUTH=false
AUTH_API_KEY=
ALLOW_DEV_AUTH=true

# Allowed CORS Origins (comma-separated or "*")
ALLOWED_ORIGINS=*
ENVIRONMENT=production
