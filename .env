# ==============================================================================
# MongoDB Ultra-Lightweight Document Q&A RAG Backend - Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Local MongoDB Connection
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=mini_rag

# Optional: Set to your Atlas Vector Search index name if using Atlas cloud.
# For local MongoDB, keep this empty so it uses the built-in vectorized cosine similarity search.
ATLAS_VECTOR_INDEX_NAME=

# ------------------------------------------------------------------------------
# External AI Providers (Google Gemini via HTTPX)
# ------------------------------------------------------------------------------
# Set your Gemini API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AQ.Ab8RN6IjlIJFSb1IxYd_bbo7j5XZSGxn25HdSIvAsdOpwRqGgA

# Embedding API (Gemini gemini-embedding-001, 3072 dimensions)
EMBEDDING_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1/embeddings
EMBEDDING_API_KEY=AQ.Ab8RN6IjlIJFSb1IxYd_bbo7j5XZSGxn25HdSIvAsdOpwRqGgA
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=3072
EMBEDDING_TIMEOUT_SECONDS=30.0

# LLM Chat Completion API (Gemini 3.8 Flash)
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/v1/chat/completions
LLM_API_KEY=AQ.Ab8RN6IjlIJFSb1IxYd_bbo7j5XZSGxn25HdSIvAsdOpwRqGgA
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=45.0

# ------------------------------------------------------------------------------
# RAG Chunking & Retrieval Parameters
# ------------------------------------------------------------------------------
MAX_UPLOAD_MB=10
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_CHUNKS=500
TOP_K=5

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# In production, set AUTH_API_KEY and set ALLOW_DEV_AUTH=false
AUTH_API_KEY=
ALLOW_DEV_AUTH=true

# Allowed CORS Origins (comma-separated or "*")
ALLOWED_ORIGINS=*
ENVIRONMENT=production
